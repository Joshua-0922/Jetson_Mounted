<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>system_identification</name>
  <version>0.1.0</version>
  <description>Offboard system-identification flights over MAVLink (ground PC to Pixhawk via telemetry radio)</description>
  <maintainer email="nachoigpt@gmail.com">Joshua-0922</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <!-- pymavlink comes from pip (pip install pymavlink); there is no rosdep key on Jazzy -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

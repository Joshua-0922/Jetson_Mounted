<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yolo_detector</name>
  <version>0.1.0</version>
  <description>YOLO (Ultralytics, best.pt x_marker) detector on the IMX219 image stream</description>
  <maintainer email="nayoonho0922@snu.ac.kr">Joshua-0922</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>imx219_camera</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
